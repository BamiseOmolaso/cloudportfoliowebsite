# Managed by Ansible. Edit the variables, not this file.
[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_key.content | default('') | b64decode | trim }}
{% for peer in wireguard_peers %}

# {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}
{% endfor %}
