# Managed by Ansible. k3s reads this file at start-up.

# Only the owner (root) may read the admin kubeconfig on the server.
write-kubeconfig-mode: "0600"

# The API server's TLS certificate must list every address you connect to,
# otherwise kubectl from your laptop refuses it. We use the public IP.
tls-san:
  - "{{ ansible_host }}"

# Encrypt Kubernetes Secrets in the cluster's database (not just base64).
secrets-encryption: true

node-name: "{{ inventory_hostname }}"
