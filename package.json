{
  "name": "portfoliowebsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "prepare": "[ \"$CI\" = true ] || husky install || true",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "predeploy": "bash scripts/predeploy.sh",
    "setup:docker": "bash scripts/setup-docker.sh",
    "setup:native": "bash scripts/setup-native.sh",
    "db:reset": "bash scripts/reset-db.sh",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "test:db": "node scripts/test-db-connection.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@heroicons/react": "^2.0.18",
    "@prisma/client": "^6.19.3",
