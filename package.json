    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
