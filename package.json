    "react": "^18.2.0",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-intersection-observer": "^9.4.3",
    "redis": "^5.12.1",
    "resend": "^4.2.0",
    "zod": "^3.22.4"
