    "@types/react-google-recaptcha": "^2.1.9",
    "autoprefixer": "^10.6.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "dotenv": "^16.6.1",
    "framer-motion": "^10.18.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^2.36.0",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.27",
